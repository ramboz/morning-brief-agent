# Actual config files (contain personal info — commit only .example.json versions)
skills/*/config/*.json
!skills/*/config/*.example.json
config/*.json
!config/*.example.json

# State files (runtime state, not source of truth)
skills/morning-assistant/state/wiki-state.json
skills/morning-assistant/state/last-run.json

# Environment variables (API tokens)
scripts/.env
.env

# Node
node_modules/

# Daily brief output (goes to Obsidian vault, not the repo)
output/

# Logs
logs/

# AI Radar dedup cache
logs/ai-radar-seen.json

# macOS
.DS_Store

token.json

# >>> jig secret-ignore >>>
# jig secret-prevention floor (ADR-0013) - git-ignore common secret
# files so they can't be staged by accident. Edit above/below the
# markers; this block is regenerated by jig and re-runs are idempotent.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
*.pem
*.key
secrets/
credentials/
# <<< jig secret-ignore <<<
