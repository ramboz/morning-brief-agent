{
  "env": {
    "PATH": "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "permissions": {
    "allow": [
      "Read",
      "WebSearch",
      "WebFetch(domain:api.slack.com)",
      "WebFetch(domain:docs.slack.dev)",
      "WebFetch(domain:techcrunch.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "Skill(morning-assistant *)",
      "Skill(morning-spike *)",
      "Skill(update-config *)",

      "Bash(node *)",

      "Bash(export PATH *)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(cp *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(curl *)",
      "Bash(command *)",
      "Bash(python3 *)",
      "Bash(jq *)",

      "Bash(git *)",
      "Bash(npm *)",
      "Bash(gh *)",
      "Bash(brew *)",

      "mcp__Control_Chrome__list_tabs",
      "mcp__Control_Chrome__switch_to_tab",
      "mcp__Control_Chrome__execute_javascript",
      "mcp__Control_Chrome__get_current_tab"
    ]
  }
}
