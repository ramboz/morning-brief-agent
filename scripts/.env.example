# Morning Assistant v2 — Helper Script Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# JIRA DC
# PAT-only Bearer auth — no username needed.
# Create your token at: https://jira.yourcompany.com/secure/ViewProfile.jspa → Personal Access Tokens
JIRA_BASE_URL=https://jira.yourcompany.com
JIRA_API_TOKEN=

# Confluence DC
# PAT-only Bearer auth — no username needed.
# Create your token at: https://confluence.yourcompany.com/secure/ViewProfile.jspa → Personal Access Tokens
CONFLUENCE_BASE_URL=https://confluence.yourcompany.com
CONFLUENCE_API_TOKEN=

# GitHub.com (fallback if connector unavailable)
GITHUB_COM_TOKEN=

# Corporate GitHub
GITHUB_CORP_BASE_URL=https://github.yourcompany.com/api/v3
GITHUB_CORP_TOKEN=

# Anthropic (for AI Radar triage)
ANTHROPIC_API_KEY=

# Behaviour
LOOKBACK_HOURS=24
