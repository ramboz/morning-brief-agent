{
  "name": "morning-brief-agent",
  "version": "2.0.0",
  "description": "Personal productivity agent — morning brief + deep dive across work tools",
  "type": "module",
  "private": true,
  "scripts": {
    "brief": "node scripts/write-brief.js --brief",
    "fetch:jira": "node scripts/fetch-jira.js --brief",
    "fetch:confluence": "node scripts/fetch-confluence.js --brief",
    "fetch:github-com": "node scripts/fetch-github-com.js --brief",
    "fetch:github-corp": "node scripts/fetch-github-corp.js --brief",
    "list:review-requests": "node scripts/list-review-requests.js --brief",
    "write:review-artifact": "node scripts/write-review-artifact.js",
    "fetch:slack": "node scripts/fetch-slack.js --brief",
    "fetch:ai-radar": "node scripts/fetch-ai-radar.js --brief",
    "test": "node --test tests/",
    "prepare": "husky"
  },
  "dependencies": {
    "@slack/web-api": "^7.15.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
